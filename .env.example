# Zet deze in Vercel onder Settings → Environment Variables.
SUPABASE_URL=https://jouwproject.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Geheim! Alleen in Vercel zetten, nooit in de code. Nodig voor gebruikers toevoegen en verwijderen.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# true = iedereen kan zelf een account maken. Leeg laten = alleen mensen die een beheerder toevoegt.
ALLOW_SIGNUP=
# true = alle modules en onderwerpen tijdelijk open, bijvoorbeeld om alles door te lopen. Openingsregels blijven bewaard.
UNLOCK_ALL=

# Koppeling met het CRM (portal.pmagency.nl), voor de dagelijkse synchronisatie van sales.
# Gebruik bij voorkeur een eigen account met alleen leesrechten. Wachtwoord als Secret opslaan.
FIELDSTARS_USERNAME=
FIELDSTARS_PASSWORD=
# De link van de Excel-export van de orders, met {van} en {tot} op de plek van de datums (dd-mm-jjjj).
FIELDSTARS_EXPORT_URL=
# Optioneel: aantal dagen terug dat elke nacht wordt opgehaald (standaard 7).
FIELDSTARS_DAYS=7
# Geheime tekst die Vercel meestuurt met de nachtelijke taak. Kies zelf een lange willekeurige tekst.
CRON_SECRET=
